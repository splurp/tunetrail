# Copy to .env and fill in. Never commit .env.

# Your server's hostname (e.g. tunetrail.duckdns.org) — must point at this VM.
DOMAIN=tunetrail.duckdns.org

# Supabase → Connect (top bar) → Connection String → type URI → "Session pooler",
# with your database password filled in.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# 48+ random characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=

# OAuth client IDs whose Google sign-in tokens are accepted (comma-separated):
# the Web client (used by Android/iOS) and the Desktop client.
GOOGLE_CLIENT_IDS=1234-web.apps.googleusercontent.com,1234-desktop.apps.googleusercontent.com

# Let players without a Google account trade as guests (true/false).
ALLOW_GUESTS=false

# Admin accounts: comma-separated player ids (Settings → Player ID in the game,
# e.g. g_1234567890). Only these accounts can use the debug tools, and only in
# the admin build of the game (built on your own PC, never published).
ADMINS=

# Push notifications (optional): your Firebase service account key file,
# base64-encoded on one line (base64 -w0 service-account.json). See
# docs/multiplayer-setup.md, step 7.
FIREBASE_SERVICE_ACCOUNT_B64=

# Secret that decides which songs spawn where (any long random string, e.g.
# openssl rand -base64 32). Keep it private: with it, spawns could be
# predicted. If it's left empty, one is derived from SESSION_SECRET.
SPAWN_SEED=
