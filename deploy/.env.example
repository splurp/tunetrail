# Copy to .env and fill in. Never commit .env.

# Your server's hostname (e.g. tunetrail.duckdns.org) — must point at this VM.
DOMAIN=tunetrail.duckdns.org

# Supabase → Connect (top bar) → Connection String → type URI → "Session pooler",
# with your database password filled in.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# 48+ random characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=

# OAuth client IDs whose Google sign-in tokens are accepted (comma-separated):
# the Web client (used by Android/iOS) and the Desktop client.
GOOGLE_CLIENT_IDS=1234-web.apps.googleusercontent.com,1234-desktop.apps.googleusercontent.com

# Let players without a Google account trade as guests (true/false).
ALLOW_GUESTS=false
